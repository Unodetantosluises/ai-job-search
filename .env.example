# ====================================================================
# Configuración de AI Job Search CLI (.env)
# Copia este archivo como .env y añade tu clave de API de Google Gemini.
# ====================================================================

# Google Gemini API Key (Obligatorio)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo de Google Gemini a utilizar (Opcional, por defecto: gemini-3.1-flash-lite)
# Opciones comunes: gemini-3.1-flash-lite, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite
